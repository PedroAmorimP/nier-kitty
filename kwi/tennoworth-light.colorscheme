# Tennoworth light terminal colors for Kwi, in the Konsole color scheme format.
# Generated from kitty/tennoworth-light.conf; keep the two in sync.

[General]
Description=Tennoworth Light
Opacity=1
Wallpaper=

# Default text. Bold keeps the normal foreground, as in Kitty.
[Foreground]
Color=47,43,32

[ForegroundIntense]
Color=47,43,32

[ForegroundFaint]
Color=90,86,72

[Background]
Color=219,215,191

[BackgroundIntense]
Color=219,215,191

[BackgroundFaint]
Color=219,215,191

# ANSI colors 0-7, their bright variants (8-15), and Konsole's faint variants
# (dim_opacity 0.75 over the background). Kwi reads only normal and bright.

[Color0]
Color=242,239,224

[Color0Intense]
Color=95,90,71

[Color0Faint]
Color=236,233,216

[Color1]
Color=151,8,43

[Color1Intense]
Color=118,1,31

[Color1Faint]
Color=168,60,80

[Color2]
Color=0,85,13

[Color2Intense]
Color=1,67,9

[Color2Faint]
Color=55,118,58

[Color3]
Color=102,48,0

[Color3Intense]
Color=81,37,0

[Color3Faint]
Color=131,90,48

[Color4]
Color=37,35,133

[Color4Intense]
Color=28,18,118

[Color4Faint]
Color=83,80,148

[Color5]
Color=97,53,91

[Color5Intense]
Color=81,38,75

[Color5Faint]
Color=128,94,116

[Color6]
Color=2,75,86

[Color6Intense]
Color=2,59,68

[Color6Faint]
Color=56,110,112

[Color7]
Color=70,66,47

[Color7Intense]
Color=31,28,20

[Color7Faint]
Color=107,103,83
