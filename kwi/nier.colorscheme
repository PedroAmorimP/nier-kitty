# NieR terminal colors for Kwi, in the Konsole color scheme format (Konsole reads it too).
# Generated from kitty/nier.conf; keep the two in sync. See README.md for credits.

[General]
Description=NieR
Opacity=1
Wallpaper=

# Default text. Bold keeps the normal foreground, as in Kitty.
[Foreground]
Color=214,198,162

[ForegroundIntense]
Color=214,198,162

[ForegroundFaint]
Color=136,126,102

[Background]
Color=20,17,13

[BackgroundIntense]
Color=20,17,13

[BackgroundFaint]
Color=20,17,13

# ANSI colors 0-7, their bright variants (8-15), and Konsole's faint variants
# (dim_opacity 0.6 over the background). Kwi reads only normal and bright.

[Color0]
Color=28,24,20

[Color0Intense]
Color=148,128,97

[Color0Faint]
Color=25,21,17

[Color1]
Color=206,93,68

[Color1Intense]
Color=224,108,78

[Color1Faint]
Color=132,63,46

[Color2]
Color=138,156,74

[Color2Intense]
Color=164,184,90

[Color2Faint]
Color=91,100,50

[Color3]
Color=216,150,62

[Color3Intense]
Color=238,174,82

[Color3Faint]
Color=138,97,42

[Color4]
Color=106,138,160

[Color4Intense]
Color=130,164,188

[Color4Faint]
Color=72,90,101

[Color5]
Color=168,115,149

[Color5Intense]
Color=190,134,168

[Color5Faint]
Color=109,76,95

[Color6]
Color=130,180,168

[Color6Intense]
Color=158,212,196

[Color6Faint]
Color=86,115,106

[Color7]
Color=214,198,162

[Color7Intense]
Color=242,228,188

[Color7Faint]
Color=136,126,102
